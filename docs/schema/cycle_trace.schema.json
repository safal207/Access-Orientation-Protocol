{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aop.local/schemas/cycle_trace.schema.json",
  "title": "AOP Cycle Trace",
  "type": "object",
  "required": ["cycle_id", "objective", "stages", "world_verdict"],
  "properties": {
    "cycle_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["stage_id", "name", "status", "evidence"],
        "properties": {
          "stage_id": {
            "type": "string",
            "enum": ["00", "01", "02", "03", "04", "05", "06", "07"]
          },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "partial", "failed"] },
          "notes": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "world_verdict": {
      "type": "string",
      "enum": ["validated", "partial", "invalidated"]
    },
    "next_cycle_inputs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
